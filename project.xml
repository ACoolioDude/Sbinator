<?xml version="1.0" encoding="utf-8"?>
<project>
    <meta title="Sbinator Engine" package="com.acooliodude.sbinator" version="0.0.1" company="Sbinator-hub" />
    <app main="Main" file="SbinatorEngine" path="export" />
    <window width="1280" height="720" fps="60" background="0x000000" hardware="true" vsync="false" />

    <source path="src" />

    <haxedef name="no-deprecation-warnings"/>
    <haxedef name="message.reporting" value="pretty" />

    <haxeflag name="-D" value="keep_inline_positions" />

    <haxedef name="HXCPP_STACK_TRACE" />
    <haxedef name="HXCPP_STACK_LINE" />

    <haxeflag name="-dce" value="no" />

    <haxedef name="no-compilation" if="never" /> 
    <define name="NO_PRECOMPILED_HEADERS" />

    <haxelib name="away3d" />
    <haxelib name="lime" />
    <haxelib name="openfl" />
    <haxelib name="hxvlc" />
    <haxelib name="hxp" />

    <assets path="assets" rename="assets" />
    <assets path="assets/images" rename="images" />
    <assets path="assets/data/" rename="data" />
    <assets path="assets/sounds" rename="sounds" />
    <assets path="assets/music" rename="music" />
    <assets path="assets/videos" rename="videos" />

    <set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />

    <assets path='app/icon.png' rename='icon.png' if='linux || mac' />
    <icon path="app/icon.png" size="256" />
</project>